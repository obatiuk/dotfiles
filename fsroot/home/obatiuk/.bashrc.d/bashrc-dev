#!/usr/bin/env -S echo "This should not be run directly. Use: \nsource"
#
# Development Environment Configuration
#
# Sets XDG defaults, configures ADB, loads NVM, and defines utility functions
#
# Note: This file is intended to be SOURCED by your .bashrc
#
# shellcheck shell=bash
# shellcheck disable=SC2148,SC1091


# --- XDG Base Directory Specification ---

# Sets XDG_DATA_HOME if it is not already set
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"

# --- ADB Environment Configuration ---

# Alias to redefine the ADB home directory to prevent it from cluttering $HOME
# The ADB daemon often creates ~/.android/adbkey, which is moved here
alias adb='HOME="${XDG_DATA_HOME}/android" adb'
alias timestamp='date +%s%3N'

# --- Node Version Manager (NVM) Setup ---

# Set NVM directory according to XDG standards
export NVM_DIR="${XDG_DATA_HOME}/nvm"

# Load NVM and its bash completion functions if they exist
[ -s "${NVM_DIR}/nvm.sh" ] && \. "${NVM_DIR}/nvm.sh"
[ -s "${NVM_DIR}/bash_completion" ] && \. "${NVM_DIR}/bash_completion"

# --- Google Cloud SDK Setup ---

# Update PATH and enable shell command completion for gcloud if the necessary files exist
if [ -f '/opt/google/google-cloud-sdk/path.bash.inc' ]; then \. '/opt/google/google-cloud-sdk/path.bash.inc'; fi
if [ -f '/opt/google/google-cloud-sdk/completion.bash.inc' ]; then \. '/opt/google/google-cloud-sdk/completion.bash.inc'; fi

# --- Python Setup ---

# Pipenv: use project based virtual environment and ignore the global virtualenv manager `pew`
export PIPENV_VENV_IN_PROJECT=1

# --- Podman setup

DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/podman/podman.sock"
export DOCKER_HOST

# --- Utility Functions ---

# Fetches and displays all available tags for a given Docker image
#
# Usage: dtags <image>
dtags() {
    local IMAGE_NAME="${1}"

    if [[ -z "${IMAGE_NAME}" ]]; then
        echo "Usage: dtags <image_name>"
        return 1
    fi

    # Determine the correct Docker Hub repository path:
    # If the name contains a slash (e.g., user/repo), use it directly
    # Otherwise, assume it's an official image (e.g., library/ubuntu)
    local REPO_PATH="${IMAGE_NAME}"
    if [[ ! "${IMAGE_NAME}" =~ / ]]; then
        REPO_PATH="library/${IMAGE_NAME}"
    fi

    curl --silent \
        "https://registry.hub.docker.com/v2/repositories/${REPO_PATH}/tags?page_size=1000" \
        | jq -r ".results[].name" \
        | sort --version-sort
}

# Lists all GPG keys authorized to decrypt a `git-crypt` repository
# It reads the key IDs from the `.git-crypt/keys/` directory and queries the
# local GPG keyring to display the associated user information for each slot,
# alongside the short key hash (last 8 characters of the fingerprint)
#
# Usage: git-crypt-list-keys [path/to/repo]
# If no path is provided, it defaults to the current directory
git-crypt-list-keys() {
    # Check if required tools are installed
    command -v git-crypt >/dev/null || { echo "Error: git-crypt is not installed." >&2; return 1; }
    command -v gpg >/dev/null || { echo "Error: gpg is not installed." >&2; return 1; }

    # Use provided path or default to current directory
    local repo_dir="${1:-.}"
    local keys_dir="${repo_dir}/.git-crypt/keys"

    # Verify the target directory actually has a `git-crypt` keys folder
    if [[ ! -d "$keys_dir" ]]; then
        echo "Error: No git-crypt keys directory found at '$keys_dir'." >&2
        return 1
    fi

    for key_dir in "$keys_dir"/*; do
        # Skip if it's not a directory (e.g., if the keys folder is empty)
        [[ -d "$key_dir" ]] || continue

        echo -e "\n🔑 Git-crypt key slot: $(basename "$key_dir")"
        echo "----------------------------------------"

        find "$key_dir" -name "*.gpg" | while read -r gpgfile; do
            local key_id short_hash
            key_id=$(basename "$gpgfile" .gpg)

            # The short key hash is the last 8 characters of the GPG fingerprint
            short_hash="${key_id: -8}"

            echo -e "Short Hash: \033[1m${short_hash}\033[0m (Fingerprint: ${key_id})\n"
            gpg --list-keys "$key_id" 2>/dev/null || echo "   Unknown Key ID: $key_id"
            echo ""
        done
    done
}
