#!/usr/bin/env bash

#
# Monitor Configuration Switcher
#
# This script switches between a single-monitor and a three-monitor setup
# using `gdctl`
#
# Usage:
#   ./switch-monitor single   - Activates the main monitor (DP-6) only
#   ./switch-monitor all      - Activates and aligns all three monitors
#
# shellcheck disable=SC2086

set -euo pipefail

# The primary monitor, used for the 'single' setup.
MAIN_MONITOR_CONFIG="-L -M DP-6 --mode 3840x1600@59.994 --primary --transform normal"

# The full configuration for the 'all' setup.
ALL_MONITORS_CONFIG="-L -M DP-4 --mode 2560x1440@59.951 --transform 270 --x 0 --y 0 \
 -L -M DP-6 --mode 3840x1600@59.994 --primary --transform normal --x 1440 --y 0 \
 -L -M eDP-1 --mode 1920x1080@59.963 --transform normal --x 5280 --y 0"

# --- Functions ---

function usage {
    echo "Usage: $(basename "$0") <mode>"
    echo "Modes:"
    echo "  single: Activates the primary DP-6 monitor only"
    echo "  all:    Activates and aligns all three monitors (DP-4, DP-6, eDP-1)"
    return 1
}

# Check if gdctl is available
command -v gdctl > /dev/null 2>&1 || {
    echo "ERROR: 'gdctl' command not found. Aborting."
    return 1
}

# Ensure exactly one argument is provided
if [ "$#" -ne 1 ]; then
    usage
fi

MODE="$1"

case "$MODE" in
    single)
        echo "Switching to single-monitor mode (DP-6) ..."
        gdctl set ${MAIN_MONITOR_CONFIG}
        ;;
    all)
        echo "Switching to all-monitors mode (DP-4, DP-6, eDP-1) ..."
        gdctl set ${ALL_MONITORS_CONFIG}
        sleep 0.5
		# Workaround: Second invocation to fix the wallpaper glitch
        gdctl set ${ALL_MONITORS_CONFIG}
        brightnessctl set -d intel_backlight 264
        ;;
    *)
        echo "ERROR: Unknown mode '$MODE'."
        usage
        ;;
esac

echo "Monitor configuration complete."
