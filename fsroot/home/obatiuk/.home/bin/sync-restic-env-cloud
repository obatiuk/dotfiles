#!/usr/bin/env bash
#
# Restic Secrets Migration Script
#
# This script retrieves Restic repository credentials (URL and password) from
# the local 'pass' store and places them into the system keyring
# via 'secret-tool' for easier retrieval by systemd services.
#
# --- Example pass file format ---
# File: infra/home/service/restic/remote/<env-name>
# --------------------------------
# my_restic_repo_encryption_password
# url: b2:my-bucket-name/restic-repo
# --------------------------------

# --- Functions ---

print_help() {
    cat << EOF
Usage: $(basename "$0") --env-name=<environment>

Retrieves Restic repository credentials from the 'pass' store and
migrates them to the system keyring using 'secret-tool'.

Options:
    --env-name=<name>   Required. The name of the environment (e.g., cloud).
    -h, --help          Show this help message and exit.

Example:
    $(basename "$0") --env-name=cloud
EOF
}

# --- Initialization & Parsing ---

_restic_repo_name=""

while [[ "$#" -gt 0 ]]; do
    case $1 in
        --env-name=*)
            _restic_repo_name="${1#*=}"
            ;;
        --env-name)
            if [[ -n "${2:-}" ]] && [[ "${2:-}" != -* ]]; then
                _restic_repo_name="$2"
                shift
            else
                echo "ERROR: --env-name requires a value." >&2
                echo "" >&2
                print_help >&2
                exit 1
            fi
            ;;
        -h|--help)
            print_help
            exit 0
            ;;
        *)
            echo "ERROR: Unknown parameter passed: $1" >&2
            echo "" >&2
            print_help >&2
            exit 1
            ;;
    esac
    shift
done

# --- Validation ---

if [[ -z "${_restic_repo_name}" ]]; then
    echo "ERROR: The --env-name parameter is required." >&2
    echo "" >&2
    print_help >&2
    exit 1
fi

command -v pass > /dev/null 2>&1 || { echo "ERROR: 'pass' command not found. Aborting!" >&2; exit 1; }
command -v secret-tool > /dev/null 2>&1 || { echo "ERROR: 'secret-tool' command not found. Aborting!" >&2; exit 1; }

# --- Execution ---

_restic_pass_file="infra/home/service/restic/remote/${_restic_repo_name}"

echo "Retrieving restic server configuration and credentials for '${_restic_repo_name}' from pass store..."

# Retrieve URL and check for pass errors
if ! _restic_repository=$(pass meta "${_restic_pass_file}" url 2>&1); then
    echo "ERROR: Failed to retrieve repository URL from pass." >&2
    echo "Command output: ${_restic_repository}" >&2
    exit 1
fi

# Retrieve Password securely and check for pass errors
if ! _pass_output=$(pass show "${_restic_pass_file}" 2>&1); then
    echo "ERROR: Failed to retrieve password from pass." >&2
    echo "Command output: ${_pass_output}" >&2
    exit 1
fi

# Extract just the first line for the password
_restic_password=$(echo "${_pass_output}" | head -n 1)

# Ensure the extracted values are not empty
if [[ -z "${_restic_repository}" ]]; then
    echo "ERROR: Retrieved URL is empty. Check the 'url' metadata in ${_restic_pass_file}." >&2
    exit 1
fi

if [[ -z "${_restic_password}" ]]; then
    echo "ERROR: Retrieved password is empty. Check the contents of ${_restic_pass_file}." >&2
    exit 1
fi

echo "Storing restic credentials for '${_restic_repo_name}' into keyring..."

# Note: Using printf "%s" instead of echo -n is safer for strings containing backslashes or starting with dashes
if ! printf "%s" "${_restic_repository}" \vert{} secret-tool store --label="URL for '${_restic_repo_name}' restic repository" \
    repository "${_restic_repo_name}" \
    type url \
    service backup \
    app_id restic; then
    echo "ERROR: Failed to store repository URL in the keyring." >&2
    exit 1
fi

if ! printf "%s" "${_restic_password}" \vert{} secret-tool store --label="Password for '${_restic_repo_name}' restic repository" \
    repository "${_restic_repo_name}" \
    type password \
    service backup \
    app_id restic; then
    echo "ERROR: Failed to store password in the keyring." >&2
    exit 1
fi

echo "Migration for '${_restic_repo_name}' complete!"

# --- Cleanup ---

unset _restic_repo_name
unset _restic_pass_file
unset _restic_repository
unset _restic_password
unset _pass_output
