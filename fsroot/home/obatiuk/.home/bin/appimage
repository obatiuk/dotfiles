#!/bin/bash

# Configuration directories
BIN_DIR="$HOME/.local/bin/appimage"
DESKTOP_DIR="$HOME/.local/share/applications"
ICON_DIR="$HOME/.local/share/icons/appimage"

# Updater Configuration
UPDATER_URL="https://github.com/AppImageCommunity/AppImageUpdate/releases/download/continuous/appimageupdatetool-x86_64.AppImage"
UPDATER_BIN="$BIN_DIR/appimageupdatetool"

# Ensure necessary directories exist
mkdir -p "$BIN_DIR" "$DESKTOP_DIR" "$ICON_DIR"

# Helper function to update the OS app menu cache
refresh_desktop_menu() {
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$DESKTOP_DIR" &>/dev/null || true
    fi
}

# Helper function to ask for user confirmation. Returns 0 if success.
ask() {
    local prompt_text="$1"
    local confirm
    read -r -p "$prompt_text [y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        return 0
    fi
	return 1
}

# Function to ensure the AppImageUpdate tool is installed
ensure_updater() {
    if [[ ! -f "$UPDATER_BIN" ]]; then
        echo "AppImageUpdate tool not found. Downloading it now..."
        wget -q --show-progress "$UPDATER_URL" -O "$UPDATER_BIN" || { echo "Failed to download updater."; exit 1; }
        chmod +x "$UPDATER_BIN"
        echo "Updater installed."
    fi
}

# Function to list installed AppImages
list_apps() {
    echo "Installed AppImages in $BIN_DIR:"
    echo "----------------------------------------"

    local found_apps=0

    for app in "$BIN_DIR"/*; do
        if [[ -f "$app" ]]; then
            local app_name
            app_name=$(basename "$app")

            if [[ "$app_name" != "appimageupdatetool" ]]; then
                echo "$app_name"
                found_apps=1
            fi
        fi
    done

    if [[ $found_apps -eq 0 ]]; then
        echo "No AppImages installed yet."
    fi
    echo "----------------------------------------"
}

# Function to install (or re-integrate) an AppImage
install_appimage() {
    local source="$1"
    local is_inplace_update="$2"

    if [[ -z "$source" ]]; then
        echo "Error: Please provide a local file path or URL."
        return 1
    fi

    local filename
    filename=$(basename "${source%%\?*}")

    local dest_path="$BIN_DIR/$filename"

    # Download or copy the file (Skip if we are just re-integrating after an update)
    if [[ "$is_inplace_update" != "true" ]]; then
        echo "Fetching $filename..."
        if [[ "$source" =~ ^https?:// ]]; then
            wget -q --show-progress "$source" -O "$dest_path" || { echo "Download failed."; rm -f "$dest_path"; exit 1; }
        else
            if [[ ! -f "$source" ]]; then
                echo "Error: Local file '$source' not found."
                exit 1
            fi

            # Check if it's already the exact same file (inode check)
            if [[ "$source" -ef "$dest_path" ]]; then
                echo "File is already in the destination directory. Re-integrating..."
            else
                echo "Moving file to $BIN_DIR..."
                # Use -i to prevent silent overwrite of a different file with the same name
                mv -i "$source" "$dest_path" || { echo "Move failed or canceled."; exit 1; }
            fi
        fi
    else
        dest_path="$source"
    fi

    chmod +x "$dest_path"
    echo "Extracting desktop integration files..."

    local temp_dir
    temp_dir=$(mktemp -d)

    cd "$temp_dir" || exit 1

    "$dest_path" --appimage-extract > /dev/null 2>&1

    if [[ -d "squashfs-root" ]]; then
        local desktop_file
        desktop_file=$(find squashfs-root -maxdepth 1 -name "*.desktop" | head -n 1)

        if [[ -n "$desktop_file" ]]; then
            # Use the .desktop filename for the AppImage if available
            local target_name
            target_name=$(basename "$desktop_file" .desktop)
            local new_dest_path="$BIN_DIR/${target_name}.AppImage"

            # Rename the file to match the desktop file name safely
            if [[ "$dest_path" != "$new_dest_path" ]]; then
                echo "Renaming to extracted name: ${target_name}.AppImage"
                # Check for collision before renaming
                if [[ -e "$new_dest_path" && ! "$dest_path" -ef "$new_dest_path" ]]; then
                    mv -i "$dest_path" "$new_dest_path"
                else
                    mv "$dest_path" "$new_dest_path"
                fi
                dest_path="$new_dest_path"
            fi

            local icon_name
            icon_name=$(grep -E "^Icon=" "$desktop_file" | head -n 1 | cut -d= -f2 | tr -d '\r')

            local icon_file
            icon_file=$(find squashfs-root -name "${icon_name}.png" -o -name "${icon_name}.svg" | head -n 1)

            if [[ -z "$icon_file" && -f squashfs-root/.DirIcon ]]; then
                icon_file="squashfs-root/.DirIcon"
            fi

            local final_icon_path="$icon_name"

            if [[ -n "$icon_file" ]]; then
                local ext="${icon_file##*.}"
                [[ "$icon_file" == *".DirIcon" ]] && ext="png"
                final_icon_path="$ICON_DIR/${target_name}_icon.${ext}"
                cp "$icon_file" "$final_icon_path"
            fi

            local final_desktop_path="$DESKTOP_DIR/${target_name}.desktop"
            cp "$desktop_file" "$final_desktop_path"

            # SECURITY: Escape '&' and '~' in paths to prevent Sed injection bugs
            local safe_dest_path="${dest_path//&/\\&}"
            safe_dest_path="${safe_dest_path//~/\\~}"

            local safe_icon_path="${final_icon_path//&/\\&}"
            safe_icon_path="${safe_icon_path//~/\\~}"

            sed -i "s~^Exec=.*~Exec=\"$safe_dest_path\" %U~" "$final_desktop_path"
            sed -i "s~^TryExec=.*~TryExec=\"$safe_dest_path\"~" "$final_desktop_path"
            sed -i "s~^Icon=.*~Icon=$safe_icon_path~" "$final_desktop_path"

            # Ensure execution permissions for Desktop Environments
            chmod +x "$final_desktop_path"

            echo "Integration complete for '$target_name'."
        else
            # Clean and lowercase the original filename if .desktop file is not available
            echo "Warning: No .desktop file found. Skipping menu integration."

            local raw_app_name="${filename%.*}" # Strip original extension
            local clean_name
            clean_name=$(echo "$raw_app_name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\+/-/g' | sed 's/-$//')
            local new_dest_path="$BIN_DIR/${clean_name}.appimage"

            if [[ "$dest_path" != "$new_dest_path" ]]; then
                echo "Applying fallback rename to clean format: ${clean_name}.appimage"
                # Check for collision on auto-rename
                if [[ -e "$new_dest_path" && ! "$dest_path" -ef "$new_dest_path" ]]; then
                    mv -i "$dest_path" "$new_dest_path"
                else
                    mv "$dest_path" "$new_dest_path"
                fi
                dest_path="$new_dest_path"
            fi
        fi
    else
        echo "Warning: Failed to extract AppImage (ensure 'fuse' and 'fuse-devel' packages are installed)."
    fi

    # Cleanup
    cd "$HOME" || exit 1
    rm -rf "$temp_dir"

    refresh_desktop_menu
}

# Function to recursively find, move, and install AppImages
import_dir() {
    local search_dir="$1"

    if [[ -z "$search_dir" || ! -d "$search_dir" ]]; then
        echo "Error: Please provide a valid directory to scan."
        echo "Usage: $0 import <directory_path>"
        return 1
    fi

    echo "Scanning '$search_dir' recursively for AppImages..."
    echo "----------------------------------------"

    local count=0

    while IFS= read -r -d '' file; do
        local filename
        filename=$(basename "$file")
        local dest_path="$BIN_DIR/$filename"

        echo "Discovered: $filename"

        # Check if the file is already in our destination bin using -ef (checks same inode)
        if [[ "$file" -ef "$dest_path" ]]; then
            echo "-> File is already in destination folder. Re-integrating..."
            install_appimage "$dest_path" "true"
        else
            echo "-> Moving to $BIN_DIR and integrating..."
            mv -i "$file" "$dest_path"
            install_appimage "$dest_path" "true"
        fi

        count=$((count + 1))
        echo "---"
    done < <(find "$search_dir" -type f -iname "*.appimage" -print0)

    if [[ $count -eq 0 ]]; then
        echo "No .AppImage files found in '$search_dir'."
    else
        echo "Successfully imported $count AppImages."
    fi
}

# Function to update a specific AppImage
update_app() {
    local target="$1"
    local app_path="$BIN_DIR/$target"

    if [[ ! -f "$app_path" ]]; then
        echo "Error: Application '$target' not found in $BIN_DIR."
        return 1
    fi

    echo "Checking for updates: $target..."

    # -O flag tells AppImageUpdate to Overwrite the existing file instead of creating a new versioned file.
    # This ensures our existing .desktop file path doesn't break.
    if "$UPDATER_BIN" -O "$app_path"; then
        echo "Update applied (or already up to date). Re-integrating..."
        install_appimage "$app_path" "true"
    else
        echo "Update failed or skipped. (Note: The AppImage must contain embedded update information to use this feature)."
    fi
}

# Function to update all installed AppImages
update_all() {
    echo "Starting global update process..."
    for app in "$BIN_DIR"/*; do
        if [[ -f "$app" ]]; then
            local app_filename
            app_filename=$(basename "$app")
            if [[ "$app_filename" != "appimageupdatetool" ]]; then
                echo "----------------------------------------"
                update_app "$app_filename"
            fi
        fi
    done
    echo "----------------------------------------"
    echo "Global update complete."
}

# Function to safely remove an AppImage and its integration files
remove_app() {
    local target="$1"

    if [[ -z "$target" ]]; then
        echo "Error: Specify an AppImage to remove."
        return 1
    fi

    # SECURITY: Prevent directory traversal
    if [[ "$target" == */* ]]; then
        echo "Error: Please specify only the AppImage filename, not a path."
        return 1
    fi

    local app_path="$BIN_DIR/$target"

    if [[ ! -f "$app_path" ]]; then
        echo "Error: Application '$target' not found in $BIN_DIR."
        return 1
    fi

    # Find the corresponding .desktop file safely (using -F for fixed string matching)
    local desktop_file
    desktop_file=$(grep -Fl "$app_path" "$DESKTOP_DIR"/*.desktop 2>/dev/null | head -n 1)

	local icon_path
    if [[ -n "$desktop_file" ]]; then
        local raw_icon_path
        raw_icon_path=$(grep -E "^Icon=" "$desktop_file" | head -n 1 | cut -d= -f2 | tr -d '\r')
        # SECURITY: Only track if the path is strictly inside our specific ICON_DIR and exists
        if [[ -n "$raw_icon_path" && -f "$raw_icon_path" && "$raw_icon_path" == "$ICON_DIR/"* ]]; then
            icon_path="$raw_icon_path"
        fi
    fi

    echo "The following files will be deleted:"
	echo " - $app_path"
    [[ -n "$desktop_file" ]] && echo "   -- $desktop_file"
    [[ -n "$icon_path" ]] && echo "   -- $icon_path"

    if ask "Are you sure you want to completely remove '$target'?"; then
        rm -f "$app_path"
        [[ -n "$desktop_file" ]] && rm -f "$desktop_file"
        [[ -n "$icon_path" ]] && rm -f "$icon_path"

        echo "'$target' has been removed successfully."
        refresh_desktop_menu
    else
        echo "Removal canceled."
    fi
}

# Function to verify integrity between AppImages, Desktop files, and Icons
check_apps() {
    echo "Checking for inconsistencies between AppImages, .desktop files, and icons..."
    echo "----------------------------------------"

    local issues_found=0

    echo "[1/3] Verifying installed AppImages..."
    # 1. Check for AppImages that are missing .desktop files or icons
    for app in "$BIN_DIR"/*; do
        [[ ! -e "$app" ]] && continue

        if [[ -f "$app" ]]; then
            local app_name
            app_name=$(basename "$app")

            if [[ "$app_name" != "appimageupdatetool" ]]; then
                echo " - Checking app: $app_name"

                # Safe grep using -F for fixed string
                local desktop_file
                desktop_file=$(grep -Fl "$app" "$DESKTOP_DIR"/*.desktop 2>/dev/null | head -n 1)

                local needs_reintegration=0

                if [[ -z "$desktop_file" ]]; then
                    echo "   ! Missing .desktop file for: $app_name"
                    needs_reintegration=1
                else
                    local icon_path
                    icon_path=$(grep -E "^Icon=" "$desktop_file" | head -n 1 | cut -d= -f2 | tr -d '\r')

                    if [[ -z "$icon_path" || ! -f "$icon_path" ]]; then
                        echo "   ! Missing icon file for: $app_name"
                        needs_reintegration=1
                    fi
                fi

                if [[ $needs_reintegration -eq 1 ]]; then
                    issues_found=1
                    echo "   -> Re-integrating automatically to fix missing files..."
                    install_appimage "$app" "true"
                fi
            fi
        fi
    done

    echo "----------------------------------------"
    echo "[2/3] Verifying AppImage shortcuts..."
    # 2. Check for .desktop files that point to missing AppImages
    for desktop in "$DESKTOP_DIR"/*.desktop; do
        [[ ! -e "$desktop" ]] && continue

        if [[ -f "$desktop" ]]; then
            local exec_line
            exec_line=$(grep "^Exec=" "$desktop" 2>/dev/null | head -n 1)

            if [[ -n "$exec_line" ]]; then
                local exec_path
                if [[ "$exec_line" == *\"* ]]; then
                    exec_path=$(echo "$exec_line" | cut -d'"' -f2)
                else
                    exec_path=$(echo "$exec_line" | awk '{print $1}' | cut -d'=' -f2)
                fi

                # Check if this desktop file points to our BIN_DIR
                if [[ "$exec_path" == "$BIN_DIR/"* ]]; then
                    local desktop_name
                    desktop_name=$(basename "$desktop")

                    echo " - Checking shortcut: $desktop_name"

                    if [[ ! -f "$exec_path" ]]; then
                        issues_found=1
                        echo "   ! Orphaned .desktop file found: $desktop_name"
                        echo "   -> Points to missing AppImage: $exec_path"

                        if ask "   Do you want to delete this orphaned file?"; then
                            local icon_path
                            icon_path=$(grep -E "^Icon=" "$desktop" | head -n 1 | cut -d= -f2 | tr -d '\r')

                            # SECURITY: Strictly bound icon deletion to ICON_DIR
                            if [[ -n "$icon_path" && -f "$icon_path" && "$icon_path" == "$ICON_DIR/"* ]]; then
                                rm -f "$icon_path"
                            fi

                            rm -f "$desktop"
                            echo "   Deleted $desktop_name"
                        else
                            echo "   Kept $desktop_name"
                        fi
                    fi
                fi
            fi
        fi
    done

    echo "----------------------------------------"
    echo "[3/3] Verifying AppImage icons..."
    # 3. Check for orphaned icons
    for icon in "$ICON_DIR"/*; do
        [[ ! -e "$icon" ]] && continue

        if [[ -f "$icon" ]]; then
            local icon_name
            icon_name=$(basename "$icon")

            echo " - Checking icon: $icon_name"

            local referencing_desktop
            referencing_desktop=$(grep -Fl "Icon=$icon" "$DESKTOP_DIR"/*.desktop 2>/dev/null | head -n 1)

            if [[ -z "$referencing_desktop" ]]; then
                issues_found=1
                echo "   ! Orphaned icon file found: $icon_name"

				if ask "   Do you want to delete this orphaned icon?"; then
                    rm -f "$icon"
                    echo "   Deleted $icon_name"
                else
                    echo "   Kept $icon_name"
                fi
            fi
        fi
    done

    echo "----------------------------------------"
    if [[ $issues_found -eq 0 ]]; then
        echo "Check complete. All AppImages, .desktop files, and icons are properly synced."
    else
        echo "Check complete. Issues were found and handled."
        refresh_desktop_menu
    fi
}

# Command Line Interface routing
case "$1" in
    install)
        install_appimage "$2"
        ;;
    import)
        import_dir "$2"
        ;;
    list|ls)
        list_apps
        ;;
    update)
        if [[ -z "$2" ]]; then
            echo "Error: Specify an AppImage to update (use 'list' to see exact names)."
            echo "Usage: $0 update <appimage_filename>"
        else
            ensure_updater
            update_app "$2"
        fi
        ;;
    update-all)
        ensure_updater
        update_all
        ;;
    remove|rm)
        remove_app "$2"
        ;;
    check)
        check_apps
        ;;
    *)
        echo "AppImage Manager"
        echo "Usage: $0 {install|import|list(ls)|update|update-all|remove(rm)|check}"
        echo "  install <file/url>      - Download/Move an AppImage and integrate it."
        echo "  import <directory>      - Recursively find, move, and integrate all AppImages from a folder."
        echo "  list (ls)               - Show all locally installed AppImages."
        echo "  update <filename>       - Update a specific installed AppImage."
        echo "  update-all              - Check and apply updates for all installed AppImages."
        echo "  remove (rm) <filename>  - Safely delete an AppImage and its menu integration files."
        echo "  check                   - Scan for and fix inconsistencies (missing apps, menu files, or icons)."
        ;;
esac
