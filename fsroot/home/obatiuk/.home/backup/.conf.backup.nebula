#!/usr/bin/env -S echo "This should not be run directly. Use: \nsource"
#
# This file is intended to be SOURCED not executed directly.
# It defines the restic arguments for the 'nebula' backup
#
# shellcheck shell=bash
# shellcheck disable=SC2154

# --- Prerequisite Checks ---

command -v curl > /dev/null 2>&1 || { echo "ERROR: 'curl' command not found. Aborting!" >&2; return 1; }
command -v jq > /dev/null 2>&1 || { echo "ERROR: 'jq' command not found. Aborting!" >&2; return 1; }
command -v secret-tool > /dev/null 2>&1 || { echo "ERROR: 'secret-tool' command not found. Aborting!" >&2; return 1; }

# --- Helper Functions ---

# Function to load a secret and assign it to an internal variable
_load_secret() {
    local var_name="$1"
    local secret_type="$2"
    local secret_output
    local exit_code

    secret_output=$(secret-tool lookup "${_lookup_base[@]}" type "${secret_type}" 2>&1)
    exit_code=$?

    if [ "${exit_code}" -ne 0 ]; then
        echo "ERROR: Failed to retrieve ${secret_type} from keyring." >&2
        echo "       Command executed: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        echo "       Exit code: ${exit_code}" >&2
        echo "       Actual Error: ${secret_output:-<no output>}" >&2
        return 1
    fi

    if [ -z "${secret_output}" ]; then
        echo "ERROR: Keyring entry for ${secret_type} exists but is empty." >&2
        echo "       Lookup used: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        return 1
    fi

    printf -v "${var_name}" "%s" "${secret_output}"
    return 0
}

_cleanup_env() {
    unset _router_host_name _router_host _lookup_base _secrets_loaded
    unset _router_luci_url _router_luci_username _router_luci_password
    unset _rpc_auth_token _os_ver _login_params _session_id
    unset _tag_keep _tag_os_name _tag_os_version _backup_tags
    unset _auth_token_payload _os_version_payload
    unset -f _load_secret _cleanup_env
}

# --- Retrieve secrets from keyring ---

_router_host_name="nebula"
_router_host="${_router_host_name}.lan"

# Safely defined as a Bash array to prevent word-splitting
_lookup_base=(device router app_id openwrt host "${_router_host}")

_secrets_loaded=true
_load_secret "_router_luci_url" "url" || _secrets_loaded=false
_load_secret "_router_luci_username" "username" || _secrets_loaded=false
_load_secret "_router_luci_password" "password" || _secrets_loaded=false

# Basic check for credentials
if [ "${_secrets_loaded}" = false ]; then
    echo "ERROR: OpenWrt credentials for '${_router_host}' were not found or failed to load. Aborting!" >&2
    _cleanup_env
    return 1
fi

_router_luci_url="${_router_luci_url}/cgi-bin"

# --- OpenWrt authentication and data retrieval ---

_auth_token_payload=$(jq -n \
  --arg user "${_router_luci_username}" \
  --arg pass "${_router_luci_password}" \
  '{id: 1, method: "login", params: [$user, $pass]}')

# Get RPC auth token
_rpc_auth_token=$(curl -s -k -X POST "${_router_luci_url}/luci/rpc/auth" \
  -H "Content-Type: application/json" \
  --data "${_auth_token_payload}" | jq -r '.result')

if [[ "${_rpc_auth_token}" == "null" ]]; then
    echo "ERROR: Failed to retrieve RPC auth token. Check credentials and URL. Aborting!" >&2
    _cleanup_env
    return 1
fi

# Get OS version
_os_version_payload='{"id": 1, "method": "exec", "params": ["ubus call system board"]}'

_os_ver=$(curl -s -k -X POST "${_router_luci_url}/luci/rpc/sys?auth=${_rpc_auth_token}" \
  -H "Content-Type: application/json" \
  --data "${_os_version_payload}" \
  | jq -r '.result | fromjson | .release | "\(.version)-\(.revision)"')

# Get session ID
_login_params="luci_username=${_router_luci_username}&luci_password=${_router_luci_password}"
_session_id=$(curl -s -k --data-raw "${_login_params}" -c - "${_router_luci_url}/luci" \
  | grep sysauth | sed -r 's/.*sysauth.*\s+//')

if [[ -z "${_session_id}" ]]; then
    echo "ERROR: Failed to retrieve session ID. Check LuCI URL. Aborting!" >&2
    _cleanup_env
    return 1
fi

# --- Restic Command Arguments ---

_tag_keep="keep"
_tag_os_name="openwrt"
_tag_os_version="${_tag_os_name}:${_os_ver// /-}"
_backup_tags="--tag system,stream,${_tag_os_name},${_tag_os_version}"

# Arguments used for the 'restic backup' command
RESTIC_ARGS_BACKUP="--verbose --exclude-caches --cleanup-cache --no-cache \
    --host ${_router_host_name} \
    ${_backup_tags} \
    --stdin-filename openwrt-luci-backup-${_router_host}.tgz \
    --stdin-from-command -- \
    curl -s ${_router_luci_url}/cgi-backup --data-raw sessionid=${_session_id}"

# Arguments for comparing snapshots
RESTIC_ARGS_COMPARE="--host ${_router_host_name} ${_backup_tags}"

# Arguments used for the 'restic forget --prune' command
RESTIC_ARGS_PRUNE="--keep-last 10 --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --keep-yearly 5 \
    --group-by host,tags \
    --host ${_router_host_name} \
    --keep-tag ${_tag_keep} \
    ${_backup_tags}"

# Arguments for getting statistics on the latest snapshot
RESTIC_ARGS_SNAPSHOT_STATS="--host ${_router_host_name} ${_backup_tags}"

export BACKUP_CONF_NAME="${_router_host_name}"
export RESTIC_ARGS_BACKUP
export RESTIC_ARGS_COMPARE
export RESTIC_ARGS_PRUNE
export RESTIC_ARGS_SNAPSHOT_STATS

_cleanup_env
return 0
