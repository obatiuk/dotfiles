#!/usr/bin/env -S echo "This should not be run directly. Use: \nsource"
#
# This file is intended to be SOURCED not executed directly.
# It retrieves restic configuration from the system keyring
#
# shellcheck shell=bash

command -v secret-tool > /dev/null 2>&1 || { echo "ERROR: 'secret-tool' command not found. Aborting!" >&2; return 1; }

# --- General Configuration ---

_env_file_name="${BASH_SOURCE[0]##*/}"

# Get unique identifier for this backup environment from the file extension
export BACKUP_ENV_NAME="${_env_file_name##*.}"

_lookup_base=(service backup app_id restic repository "${BACKUP_ENV_NAME}")

# File path used for locking the backup process via flock
export RESTIC_LOCK_FILE="/tmp/${_env_file_name}.flock"
# Path where restic stores its cache data
export RESTIC_CACHE_DIR="${HOME}/.cache/restic/${USER}"
# Restic progress update frequency (0.016666 FPS = 1 update per minute)
export RESTIC_PROGRESS_FPS=0.016666

# --- rclone Specific Optimizations ---

# Number of streams to use for concurrent transfers (0 means unlimited)
export RCLONE_MULTI_THREAD_STREAMS=0
# Tell rclone to ignore inodes when checking for file changes
export RCLONE_IGNORE_INODE=true
# Limit the number of transactions per second (useful for APIs with rate limits)
export RCLONE_TPSLIMIT=10
# rclone configuration file path
export RCLONE_CONFIG="${XDG_CONFIG_HOME}/rclone/rclone.conf"

# Internet is required for this environment
export BACKUP_ENV_REQ_INTERNET_ONLINE=true

# --- Helper Functions ---

# Function to load a secret and assign it to an internal variable
_load_and_export_secret() {
    local env_var_name="$1"
    local secret_type="$2"
    local secret_output
    local exit_code

    secret_output=$(secret-tool lookup "${_lookup_base[@]}" type "${secret_type}" 2>&1)
    exit_code=$?

    if [ "${exit_code}" -ne 0 ]; then
        echo "ERROR: Failed to retrieve ${env_var_name} from keyring." >&2
        echo "       Command executed: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        echo "       Exit code: ${exit_code}" >&2
        echo "       Actual Error: ${secret_output:-<no output>}" >&2
        return 1
    fi

    if [ -z "${secret_output}" ]; then
        echo "ERROR: Keyring entry for ${env_var_name} exists but is empty." >&2
        echo "       Lookup used: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        return 1
    fi

    export "${env_var_name}=${secret_output}"
    return 0
}

_cleanup_env() {
    [ "${_secrets_loaded}" = true ]
    local exit_code=$?

    unset _lookup_base _env_file_name _secrets_loaded
    unset -f _load_and_export_secret _cleanup_env

    return "${exit_code}"
}

# --- Retrieve secrets from keyring ---

# Flag to track if we encountered any errors
_secrets_loaded=true

# Fetch each principal environment variable.
_load_and_export_secret "RESTIC_REPOSITORY" "url" || _secrets_loaded=false
_load_and_export_secret "RESTIC_PASSWORD" "password" || _secrets_loaded=false

# If any secret failed to load, print the error before cleanup
if [ "${_secrets_loaded}" = false ]; then
    echo "ERROR: One or more principal environment variables failed to load. Aborting environment setup." >&2
fi

_cleanup_env
return $?
