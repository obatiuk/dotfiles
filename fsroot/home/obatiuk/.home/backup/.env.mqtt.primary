#!/usr/bin/env -S echo "This should not be run directly. Use: \nsource"
#
# This file is intended to be SOURCED not executed directly.
# It retrieves MQTT server configuration from the system keyring
#
# shellcheck shell=bash
# shellcheck disable=SC2154

# Check for secret-tool availability before proceeding
command -v secret-tool > /dev/null 2>&1 || { echo "ERROR: 'secret-tool' command not found. Aborting!" >&2; return 1; }

# --- General Configuration ---

# Construct the base filename (used for environment naming).
_env_file_name="${BASH_SOURCE[0]##*/}"

# Unique identifier for this MQTT environment
export MQTT_ENV_NAME="${_env_file_name##*.}"

_lookup_base=(service publish app_id mqtt id "${MQTT_ENV_NAME}")

# --- Helper Functions ---

_load_secret() {
    local var_name="$1"
    local secret_type="$2"
    local is_optional="$3"
    local secret_output
    local exit_code

    # Attempt to lookup the secret. We capture stdout and stderr together (2>&1)
    secret_output=$(secret-tool lookup "${_lookup_base[@]}" type "${secret_type}" 2>&1)
    exit_code=$?

    # If the secret is marked optional, ignore failures and empty values
    if [ "${is_optional}" = "optional" ]; then
        if [ "${exit_code}" -ne 0 ] || [ -z "${secret_output}" ]; then
            printf -v "${var_name}" ""
            return 0
        fi
    fi

    # Check if secret-tool failed for required secrets
    if [ "${exit_code}" -ne 0 ]; then
        echo "ERROR: Failed to retrieve ${secret_type} from keyring." >&2
        echo "       Command executed: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        echo "       Exit code: ${exit_code}" >&2
        echo "       Actual Error: ${secret_output:-<no output>}" >&2
        return 1
    fi

    # Check if the command succeeded but returned an empty string for required secrets
    if [ -z "${secret_output}" ]; then
        echo "ERROR: Keyring entry for ${secret_type} exists but is empty." >&2
        echo "       Lookup used: secret-tool lookup ${_lookup_base[*]} type ${secret_type}" >&2
        return 1
    fi

    # Dynamically assign the value to the variable name
    printf -v "${var_name}" "%s" "${secret_output}"
    return 0
}

_cleanup_env() {
    [ "${_secrets_loaded}" = true ]
    local exit_code=$?

    unset _lookup_base _env_file_name _secrets_loaded
    unset _mqtt_server_host _mqtt_server_port _mqtt_server_username _mqtt_server_password
    unset _host_name _comm_name _timestamp _auth_args
    unset -f _load_secret _cleanup_env

    return "${exit_code}"
}

# --- Retrieve secrets from keyring ---

# Flag to track if we encountered any errors
_secrets_loaded=true

# Fetch REQUIRED configuration items
_load_secret "_mqtt_server_host" "host" "required" || _secrets_loaded=false
_load_secret "_mqtt_server_port" "port" "required" || _secrets_loaded=false

# Fetch OPTIONAL configuration items (username and password)
_load_secret "_mqtt_server_username" "username" "optional" || _secrets_loaded=false
_load_secret "_mqtt_server_password" "password" "optional" || _secrets_loaded=false

# If all required secrets loaded successfully, construct the arguments
if [ "${_secrets_loaded}" = true ]; then
    _host_name=$(hostname)
    _comm_name=$(ps -q $$ -o comm=)
    _timestamp=$(date +%s)

    # Only append auth arguments if the credentials actually exist
    _auth_args=""
    [ -n "${_mqtt_server_username}" ] && _auth_args="${_auth_args} -u ${_mqtt_server_username}"
    [ -n "${_mqtt_server_password}" ] && _auth_args="${_auth_args} -P ${_mqtt_server_password}"

    # Arguments for mosquitto_pub
    export MQTT_PUB_ARGS="--insecure -h ${_mqtt_server_host} -p ${_mqtt_server_port}${_auth_args} -i ${_host_name}-${_comm_name}-${_timestamp}"
else
    echo "ERROR: One or more REQUIRED MQTT environment variables failed to load. Aborting environment setup." >&2
fi


_cleanup_env
return $?
